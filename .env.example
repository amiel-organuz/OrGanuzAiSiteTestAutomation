# Base URL for the Organuz marketing site
WEB_BASE_URL=https://www.organuz.ai

# Base URL for API tests. CI overrides this to the local JSONPlaceholder mock.
API_BASE_URL=https://jsonplaceholder.typicode.com
API_TIMEOUT=15000

# Playwright settings
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
WORKERS=4
BROWSER=chromium

# --- QA MCP agent (src/agent) ---
# Azure DevOps target + blast-radius scoping
ADO_PLAN_ID=PLAN-1
ADO_SUITE_ID=SUITE-1
ADO_START_READONLY=true
# Run behaviour
QA_ENVIRONMENT=staging
QA_RERUN_FLAKY=true
QA_FLAKY_TAG=@flaky
QA_FILE_BUGS=true
QA_MAX_CASES=0
# Evidence (OneDrive) folder prefix
QA_EVIDENCE_PREFIX=qa-runs
# Requirements-document enrichment (optional). Empty path disables it.
# QA_REQUIREMENTS_PATH=test-requirements-docs
QA_REQUIREMENTS_SOURCE=local

# `npm run agent:current-tests` uses the real Playwright CLI and respects the
# normal WEB_BASE_URL/API_BASE_URL variables above while keeping ADO/Sheets/
# OneDrive stubbed locally.
